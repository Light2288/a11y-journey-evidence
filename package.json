{
  "name": "a11y-journey-evidence",
  "version": "0.1.0-batch.1",
  "private": true,
  "type": "module",
  "description": "Reviewable keyboard and focus evidence for native Playwright journeys",
  "license": "MIT",
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "npm@11.19.0",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "npm run build && tsc -p tsconfig.json --noEmit",
    "test:browser": "npm run typecheck && playwright test --config tests/playwright.config.ts"
  },
  "peerDependencies": {
    "@playwright/test": "1.64.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "@types/node": "24.19.2"
  }
}
